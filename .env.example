# Скопируйте в .env (`cp .env.example .env`): docker compose подхватывает его сам.
# .env в .gitignore, этот файл нет. Без .env всё работает на значениях ниже.

# --- Порты на ХОСТЕ ---------------------------------------------------------
# Поменяйте, если порт занят (ошибка "address already in use").
# Внутри сети compose порты не меняются, сервисы и тесты друг друга всё равно находят.

# REST API сервиса: Swagger на http://localhost:API_PORT/docs
API_PORT=8000
# Фейковые провайдеры; их настройки: PUT /_admin/config, POST /_admin/reset
ALPHA_PORT=8001
BETA_PORT=8002
# PostgreSQL (пользователь, пароль и база: app / app / app)
DB_PORT=5432

# --- Секрет подписи ---------------------------------------------------------
# Общий секрет HMAC-SHA256 для заголовка X-Signature: вебхуки провайдеров и оплат.
# test-secret это известное dev-значение. Для любого реального запуска замените.
# Менять надо сразу для всех сервисов: compose раздаёт это значение api, alpha, beta и tests.
WEBHOOK_SECRET=test-secret
